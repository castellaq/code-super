# Supernote Auto Sync - 설정 파일 예시
# 이 파일을 'config.yaml'로 복사하고 경로를 수정하세요

sync:
  # 슈퍼노트 장치의 마운트 경로 또는 소스 디렉토리
  source_path: /media/supernote

  # 백업할 대상 디렉토리
  destination_path: /home/user/Supernote/Backup

  # 동기화할 파일 확장자 (모든 파일: ['*'])
  file_extensions:
    - .note
    - .pdf
    - .txt
    - .png
    - .jpg
    - .jpeg

  # 제외할 패턴 (숨김 파일, 임시 파일 등)
  exclude_patterns:
    - '.*'      # 숨김 파일
    - '__*'     # 특수 파일
    - '.Trash'  # 휴지통

  # 동기화 모드
  # - 'one-way': 단방향 (소스 -> 대상)
  # - 'two-way': 양방향 (미구현)
  sync_mode: one-way

  # 자동 동기화 활성화
  auto_sync: true

  # 동기화 간격 (초 단위, 실시간 감지 사용 시 무시됨)
  sync_interval: 5

  # 최대 파일 크기 (MB 단위, null이면 제한 없음)
  max_file_size_mb: 100

logging:
  # 로그 레벨: DEBUG, INFO, WARNING, ERROR, CRITICAL
  level: INFO

  # 로그 파일 경로
  log_file: logs/supernote_sync.log
